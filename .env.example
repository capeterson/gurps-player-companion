# GURPS Player Companion — environment variables
# Copy to .env and fill in real values for local dev.

# Application environment: development | test | production
# Production hides /api/v1/openapi.json and the docs UI.
ENVIRONMENT=development

# HTTP server
PORT=3000
HOST=0.0.0.0

# Postgres 18 connection (matches docker-compose.dev.yml)
DATABASE_URL=postgres://gurps:gurps@localhost:5432/gurps

# JWT signing key — must be ≥ 32 chars and not a placeholder.
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-output-of-openssl-rand-hex-32

# Token lifetimes
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14

# Optional independent pepper for API-key HMAC. Falls back to JWT_SECRET when unset.
# API_KEY_PEPPER=

# CORS allowed origins (JSON array). Empty list disables CORS (same-origin only).
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:5173"]

# Public-auth abuse protection. Counters are shared in Postgres by every app
# instance. Proxy trust defaults true in production and false elsewhere.
# Behind a trusted proxy, use its final appended X-Forwarded-For hop. Ensure it
# sanitizes X-Forwarded-Proto; explicitly set false for direct hosting.
# TRUST_PROXY=false
AUTH_RATE_LIMIT_WINDOW_SECONDS=600
AUTH_RATE_LIMIT_LOGIN_MAX=10
AUTH_RATE_LIMIT_REGISTER_MAX=5
AUTH_RATE_LIMIT_RESET_MAX=3
AUTH_RATE_LIMIT_CHALLENGE_MAX=10

# Optional: Resend.com email integration.
# When set, enables password-reset emails and campaign invitation emails.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=noreply@yourdomain.com
# Bare public hostname (no scheme, port, path, or other URL components).
# Required in production, which derives https://<hostname> on port 443.
# Dev/test defaults to localhost and derives http://<hostname>:<PORT>.
# APP_HOSTNAME=yourapp.com

# Optional operator-defined public OAuth clients. ChatGPT can use Client ID
# Metadata Documents and Claude/other clients can use Dynamic Client Registration,
# so they need no entry here. Redirect URIs match exactly. Clients use
# authorization code + PKCE S256 and have no client secret.
OAUTH_CLIENTS=[]
# OAUTH_CLIENTS=[{"clientId":"desktop-agent","name":"Desktop agent","redirectUris":["http://127.0.0.1:49152/callback"],"scopes":["gpc:read","gpc:write","gpc:manage"]}]

# Optional S3-compatible photo storage (docs/media-storage.md).
# Dev/test defaults to local disk without S3; production needs S3 credentials.
# Never commit real credentials. Local storage is forbidden in production.
MEDIA_STORAGE=auto
# MEDIA_LOCAL_DIR=.local/media
# MEDIA_S3_ENDPOINT=https://your-s3-endpoint
# MEDIA_S3_REGION=garage
# MEDIA_S3_BUCKET=gpc-images
# MEDIA_S3_ACCESS_KEY=...
# MEDIA_S3_SECRET_KEY=...
MEDIA_S3_PATH_STYLE=true
MEDIA_UPLOADS_ENABLED=true
# Garage overlay only:
# MEDIA_GARAGE_RPC_SECRET=...64 hex characters...
# MEDIA_METADATA_DIR=/mnt/user/appdata/gpc-garage/meta
# MEDIA_DATA_DIR=/mnt/user/gpc-media/data
